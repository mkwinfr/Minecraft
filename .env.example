# Bedrock Panel Environment Configuration
# Copy to .env and adjust values as needed

# API Server Port
API_PORT=3001

# API Server Host
API_HOST=127.0.0.1

# Bedrock Server Path (absolute path to Bedrock Dedicated Server directory)
# Windows: C:\path\to\bedrock-server
# Linux: /opt/bedrock-server
BEDROCK_SERVER_DIR=.runtime/bedrock

# Bedrock Server Executable Name
# Windows: bedrock_server.exe
# Linux: bedrock_server
BEDROCK_SERVER_EXE=bedrock_server.exe

# Server Stop Command (sent to server console)
BEDROCK_STOP_COMMAND=stop

# Timeout for server stop (milliseconds, 1000-120000)
BEDROCK_STOP_TIMEOUT_MS=15000

# Bedrock Server Download URL (leave empty to disable auto-download)
# Example: https://launcher.mojang.com/v1/objects/...
BEDROCK_DOWNLOAD_URL=

# Web UI Origin (dev only; when production-built, UI is served from same origin)
WEB_ORIGIN=http://127.0.0.1:3001
